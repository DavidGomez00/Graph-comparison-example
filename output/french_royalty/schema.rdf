<?xml version="1.0" encoding="utf-8"?>

<!-- Hand-customized schema based on generated_schema.rdf to represent
     the French royalty graph. -->
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <!-- Ontology -->
  <owl:Ontology rdf:about="http://pygraft.t/">
    <rdfs:comment xml:lang="es">Reference ontology for a non-literal 
      French Royalty KG.</rdfs:comment>
  </owl:Ontology>

  <!-- Classes -->
  <owl:Class rdf:about="http://pygraft.t/Person">
    <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
  </owl:Class>

  <owl:Class 
    rdf:about="http://pygraft.t/PlaceholderClass" 
    rdf:comment="Pygraft needs a minimum of 2 classes to 
    work."
  />


  <!-- Relations -->
  <owl:ObjectProperty rdf:about="http://pygraft.t/parent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:domain>
      <owl:Class rdf:about="http://pygraft.t/Person"/>
    </rdfs:domain>
    <rdfs:range>
      <owl:Class rdf:about="http://pygraft.t/Person"/>
    </rdfs:range>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://pygraft.t/child">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:domain>
      <owl:Class rdf:about="http://pygraft.t/Person"/>
    </rdfs:domain>
    <rdfs:range>
      <owl:Class rdf:about="http://pygraft.t/Person"/>
    </rdfs:range>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://pygraft.t/father">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:domain>
      <owl:Class rdf:about="http://pygraft.t/Person"/>
    </rdfs:domain>
    <rdfs:range>
      <owl:Class rdf:about="http://pygraft.t/Person"/>
    </rdfs:range>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://pygraft.t/mother">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:domain>
      <owl:Class rdf:about="http://pygraft.t/Person"/>
    </rdfs:domain>
    <rdfs:range>
      <owl:Class rdf:about="http://pygraft.t/Person"/>
    </rdfs:range>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://pygraft.t/spouse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:domain>
      <owl:Class rdf:about="http://pygraft.t/Person"/>
    </rdfs:domain>
    <rdfs:range>
      <owl:Class rdf:about="http://pygraft.t/Person"/>
    </rdfs:range>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://pygraft.t/successor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:domain>
      <owl:Class rdf:about="http://pygraft.t/Person"/>
    </rdfs:domain>
    <rdfs:range>
      <owl:Class rdf:about="http://pygraft.t/Person"/>
    </rdfs:range>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://pygraft.t/predecessor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:domain>
      <owl:Class rdf:about="http://pygraft.t/Person"/>
    </rdfs:domain>
    <rdfs:range>
      <owl:Class rdf:about="http://pygraft.t/Person"/>
    </rdfs:range>
  </owl:ObjectProperty>
</rdf:RDF>
